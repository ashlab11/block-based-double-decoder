#!/usr/bin/env bash
# Train a model with arbitrary param count and token budget.
#
# Usage:
#   bash scripts/train --params 1000000 --tokens 40000000
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="$PROJECT_ROOT:${PYTHONPATH:-}"

exec torchrun --nproc_per_node=1 \
    "$PROJECT_ROOT/training/train_cli.py" "$@"
