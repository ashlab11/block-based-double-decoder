# ─────────────────────────────────────────────────────────────────────────────
# SLURM environment overrides — copy to slurm.env and edit for your cluster.
#
#   cp slurm.env.example slurm.env
#   # edit slurm.env to match your cluster's paths and modules
#   source slurm.env
#   sbatch scripts/1_setup.sh
#
# This file is irrelevant on RunPod — defaults baked into each script work
# out of the box there.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage ──────────────────────────────────────────────────────────────────
# Most clusters give you a small home quota and a large scratch volume.
# The packed 6B-token dataset is ~30 GB; checkpoints can reach 10-20 GB.
# Point both at scratch.
export DATA_DIR="${SCRATCH:-$HOME}/dd/data/Pretrain"
export TOKENIZER_DIR="${SCRATCH:-$HOME}/dd/tokenizer"
export CKPT_DIR="${SCRATCH:-$HOME}/dd/checkpoints"

# ── Wandb ────────────────────────────────────────────────────────────────────
# Set your real key (or put it in ~/.bashrc and delete this line).
# To skip wandb entirely, comment out WANDB_API_KEY and uncomment WANDB_MODE.
export WANDB_API_KEY="REPLACE_ME"
# export WANDB_MODE=offline

# ── HuggingFace ──────────────────────────────────────────────────────────────
# If your compute nodes lack internet, pre-download datasets on the login
# node and point HF at the cache.
# export HF_HOME="${SCRATCH:-$HOME}/dd/hf_cache"
# export HF_DATASETS_CACHE="${SCRATCH:-$HOME}/dd/hf_cache/datasets"

# ── Modules ──────────────────────────────────────────────────────────────────
# Adjust to whatever your cluster calls its CUDA module.
# `1_setup.sh` already runs `module load cuda/12.4` best-effort; if your
# cluster names it differently, load it here before submitting.
# module load cuda/12.4
# module load anaconda
